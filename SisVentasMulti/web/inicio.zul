<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v1"?>
<?link rel="stylesheet" type="text/css" href="/css/app/landing/signin.css?v21"?>
<?script src="/js/icon.js"?>
<?script src="./js/inicio.js?v2"?>

<?link rel="icon" type="image/x-icon" href="/iconos/defact.ico"?>
<?page title="Facturacion electrónica" contentType="text/html;charset=UTF-8"?>

<zk>

   <div class="login_container" id="loginWin" apply="com.ec.controlador.LoginController">
    <div class="wrapper_login">
        <div class="container_img">
            <image src="./imagenes/login-corporativo.png" class="login_bg"/>
            <div class="login_orb login_orb_1"/>
            <div class="login_orb login_orb_2"/>
            <div class="login_orb login_orb_3"/>
            <div class="login_orb login_orb_4"/>
            <div class="logo_box">
                <span class="logo_box_name">DEFACT</span>
            </div>
            <div class="wrapper_title">
                <span class="kicker">DEFACT</span>
                <span class="title">Facturación fácil, rápida y segura</span>
                <span class="subtitle">Todo tu negocio en un solo lugar</span>
                <div class="desc_list">
                    <span class="desc">Facturación electrónica sin complicaciones</span>
                    <span class="desc">Simplifica tu facturación y enfócate en hacer crecer tu negocio</span>
                    <span class="desc">La solución de facturación que se adapta a tu negocio</span>
                </div>
            </div>
        </div>

        <div class="container_signin">
            <image src="./imagenes/logo-defact-circle.png" class="logo"/>
            <span class="title">Iniciar sesión</span>
            <span class="subtitle">Ingresa tu usuario y contraseña</span>

            <div class="wrapper_all_inputs">
                <div class="wrapper_input">
                    <span class="fas fa-user icon"></span>
                    <textbox type="text" placeholder="Usuario" class="input" id="account" onCreate="self.focus()"/>
                </div>
                <div class="wrapper_input">
                    <span class="fas fa-lock icon"></span>
                    <textbox type="password" placeholder="Contraseña" class="input input_password" id="password"/>
                    <html sclass="icon_eye_host"><![CDATA[
                        <button type="button" class="icon_eye" title="Mostrar contraseña" aria-label="Mostrar contraseña">
                            <svg class="icon_eye_svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    ]]></html>
                </div>
            </div>

            <div class="wrapper_buttons">
                <button class="btn btn_sign" id="buttonEntrar">Iniciar sesión</button>
            </div>
        </div>
    </div>
</div>

    <div class="wrapper_loading loading_inicio">
        <div class="lds-ring"><div></div><div></div><div></div><div></div></div>
    </div>

</zk>
