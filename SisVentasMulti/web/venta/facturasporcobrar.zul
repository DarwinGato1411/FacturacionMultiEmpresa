<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v5"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v48"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/sri.css?v19"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v4"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>


<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk  contentStyle="overflow:auto" width="100%" >
    
      
   
    
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer" 
          viewModel="@id('vm') @init('com.ec.controlador.vistas.FacturasPorCobrarVm')"
          width="100%" sclass="kd-page lista_facturas_page cobrar_page" >
        <label sclass="kd-title" value="Facturas por cobrar"/>
        <label sclass="kd-sub" value="Busque por cédula o nombre y consulte saldos pendientes."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox" >
            <tabs >
                <tab label="Facturas por cobrar" sclass="menutabs" /> 
            </tabs>
            <tabpanels >
                
                <tabpanel  width="99%" class="factura lista_facturas" >                    
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field lf_field_buscar">
                                <span>Buscar</span>
                                <textbox sclass="lf_search"
                                         value="@bind(vm.nombre)"
                                         tooltiptext="Buscar por cédula o nombre"
                                         placeholder="Cédula o nombre"
                                         onOK="@command('buscar')"
                                         onChange="self.setValue(self.getValue().toUpperCase());"/>
                            </div>
                            <radiogroup class="sri_radios"
                                        onCheck="@command('buscar')"
                                        selectedItem="@bind(vm.groupby)">
                                <radio label="Detallado" value="${false}"/>
                                <radio label="Agrupar" value="${true}"/>
                            </radiogroup>
                            <button
                                class="fa-solid fa-magnifying-glass btn_fact lf_btn lf_btn_primary"
                                onClick="@command('buscar')"
                                tooltiptext="Buscar facturas por cobrar"
                                label="Buscar"/>
                        </div>
                    </div>

                    <div class="factura_body factura_body_content">
                        <listbox model="@load(vm.listaFacturas)" 
                                nonselectableTags=""  mold="paging" pageSize="12"  >
                            <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                        
                            <listhead class="encabezadolf"> 
                                <listheader width="10%"  label="N° Fact" /> 
                                <listheader width="14%">
                                    <textbox value="@bind(vm.nombre)"
                                             tooltiptext="Cédula"
                                             class="form-control form-control-sm"
                                             placeholder="Cédula"
                                             onOK="@command('buscar')"
                                             onChange="self.setValue(self.getValue().toUpperCase());"/>
                                </listheader>
                                <listheader width="46%">
                                    <textbox value="@bind(vm.nombre)"
                                             tooltiptext="Nombre del cliente"
                                             class="form-control form-control-sm"
                                             placeholder="Nombre del cliente"
                                             onOK="@command('buscar')"
                                             onChange="self.setValue(self.getValue().toUpperCase());"/>
                                </listheader>
                                <listheader width="10%"  label="Saldo ($)" align="rigth" /> 
                                <listheader width="10%"  label="Dias"  />                      
                            </listhead>  
                            
                        
                            <template name="model">                                                            
                                <listitem class="tablalf">
                                    <listcell  zclass = "mycss-listcell">
                                        <textbox readonly="true"  style="font-size:12px;background:#EBF5FB"                            
                                                class="form-control form-control-sm" 
                                                width="100%"
                                                value="@bind(each.facNumeroText)"  />
                                    </listcell>
                                    <listcell  zclass = "mycss-listcell">
                                        <textbox readonly="true"  style="font-size:12px;background:#EBF5FB"                            
                                                class="form-control form-control-sm" 
                                                width="100%"
                                                value="@bind(each.cliCedula)"  />
                                    </listcell>
                                    <listcell zclass = "mycss-listcell">
                                        <textbox readonly="true"  style="font-size:12px;background:#EBF5FB"                            
                                                class="form-control form-control-sm" 
                                                width="100%"
                                                value="@bind(each.cliNombres)"  />
                                    </listcell>
                                    <listcell zclass = "mycss-listcell">
                                        <decimalbox format="###.##" readonly="true" 
                                                    style="font-size:12px;background:#EBF5FB"
                                                    value="@bind(each.facSaldoAmortizado)" width="100%"/>
                                    </listcell>
                                    <listcell zclass = "mycss-listcell">
                                        <decimalbox format="###.##" readonly="true" 
                                                    style="font-size:12px;background:#EBF5FB"
                                                    value="@bind(each.dias)" width="100%"/>
                                    </listcell>
                                    
                                                                
                                    
                                </listitem>
                            </template>
                        </listbox>
                    </div>

         
                </tabpanel>
                

            </tabpanels>
            
        </tabbox>
        </div>
    </div>


</zk>
