<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v5"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v2"?>
<zk contentStyle="overflow:auto">
    <style>
        .z-listbox-autopaging .z-listcell-cnt {
            height: 15px;
            overflow: hidden;
        }
        .kd-page .z-listheader,
        .kd-page .z-listheader-content {
            background: #03aff1 !important;
            color: #ffffff !important;
            font-weight: 700 !important;
        }
        .kd-page .z-listheader .z-textbox,
        .kd-page .z-listheader .z-textbox-input,
        .kd-page .z-listheader .form-control {
            background: #ffffff !important;
            color: #122536 !important;
        }
        .kd-page .z-listcell,
        .kd-page .mycss-listcell,
        .kd-page .z-listcell-cnt,
        .kd-page .z-listcell .z-textbox,
        .kd-page .z-listcell .z-label {
            color: #333333 !important;
        }
        .kd-btn-ok.btn_fact {
            background: #122536 !important;
            color: #ffffff !important;
        }
        .banner,
        .banner .z-menubar,
        .banner .z-menu,
        .banner .z-menuitem,
        .banner .z-toolbarbutton,
        .banner .z-toolbarbutton-cnt {
            background: transparent !important;
            background-image: none !important;
            border: 0 none !important;
            color: #ffffff !important;
        }
        .banner, .z-north, .z-north-body {
            background: #122536 !important;
            color: #ffffff !important;
        }
    </style>
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.Compras')"
         sclass="kd-page" width="100%">

        <label sclass="kd-title" value="Ingreso de mercadería"/>
        <label sclass="kd-sub" value="Complete los datos del proveedor y la factura. Doble clic o la flecha para agregar productos."/>

        <div sclass="kd-card">
            <div sclass="kd-compra-grid">
                <div sclass="kd-compra-field">
                    <span>Cédula</span>
                    <div class="input-group">
                        <textbox placeholder="Cedula"
                                 readonly="false"
                                 onDoubleClick="@command('buscarProveedorEnLista')"
                                 value="@bind(vm.proveedorSeleccionado.provCedula)"
                                 maxlength="13"/>
                        <div class="input-group-append">
                            <button sclass="fa-solid fa-magnifying-glass btn btn-warning btn-sm"
                                    onClick="@command('buscarProveedorEnLista')"
                                    tooltiptext="Buscar proveedor"/>
                        </div>
                    </div>
                </div>
                <div sclass="kd-compra-field wide">
                    <span>Proveedor</span>
                    <textbox readonly="true"
                             placeholder="Nombre proveedor"
                             class="form-control form-control-sm"
                             value="@bind(vm.proveedorSeleccionado.provNombre)"/>
                </div>
                <div sclass="kd-compra-field">
                    <span>Fecha factura</span>
                    <datebox compact="true" value="@bind(vm.fechafacturacion)"
                             readonly="true"
                             buttonVisible="true"
                             lenient="true" format="dd/MM/yyyy"
                             class="input_date"
                             constraint="no empty: Ingrese su fecha de la orden"/>
                </div>
                <div sclass="kd-compra-field num">
                    <span>N° factura</span>
                    <div sclass="kd-num-row">
                        <textbox class="form-control form-control-sm"
                                 maxlength="3"
                                 placeholder="001"
                                 value="@bind(vm.cabeceraCompra.cabEstablecimiento)"/>
                        <span class="num_sep">-</span>
                        <textbox class="form-control form-control-sm"
                                 maxlength="3"
                                 placeholder="001"
                                 value="@bind(vm.cabeceraCompra.cabPuntoEmi)"/>
                        <span class="num_sep">-</span>
                        <textbox class="form-control form-control-sm"
                                 maxlength="9"
                                 onChange="self.setValue(self.getValue().toUpperCase());"
                                 placeholder="000000009"
                                 value="@bind(vm.numeroFactura)"/>
                    </div>
                </div>
                <div sclass="kd-compra-field">
                    <span>Estado</span>
                    <radiogroup selectedItem="@bind(vm.estdoFactura)" class="radio_group">
                        <radio label="Pagado" value="PA"/>
                        <radio label="Pendiente" value="PE"/>
                    </radiogroup>
                </div>
                <div sclass="kd-compra-field wide">
                    <span>Clave autorización</span>
                    <textbox maxlength="49"
                             placeholder="Clave autorizacion"
                             class="form-control form-control-sm"
                             value="@bind(vm.cabeceraCompra.cabAutorizacion)"/>
                </div>
            </div>

            <div sclass="kd-totales">
                <div sclass="kd-totales-grid">
                    <div class="input-contenedor">
                        <span>Subtotal 5%:</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.subTotalFactura5)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                    <div class="input-contenedor">
                        <span>Subtotal 15%:</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.subTotalFactura15)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                    <div class="input-contenedor">
                        <span>Subtotal 0%:</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.subTotalFacturaCero)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                    <div class="input-contenedor">
                        <span>IVA 5 %</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.ivaFactura5)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                    <div class="input-contenedor">
                        <span>IVA 15 %</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.ivaFactura15)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                    <div class="input-contenedor">
                        <span>Total:</span>
                        <decimalbox format="###.##"
                                    value="@bind(vm.valorTotalFactura)"
                                    readonly="true"
                                    onChange="self.setValue(self.getValue().toUpperCase().trim());"/>
                    </div>
                </div>
                <button autodisable="self"
                        label="Guardar"
                        class="fa-solid fa-floppy-disk btn_fact btn_primary kd-btn-ok"
                        onClick="@command('Guardar')"
                        tooltiptext="Guardar mercaderia"/>
            </div>
        </div>

        <div sclass="kd-split">
            <div sclass="kd-col kd-card">
                <label sclass="kd-card-title" value="Productos"/>
                <listbox model="@load(vm.listaKardexProducto)"
                         nonselectableTags="" mold="paging" pageSize="10">
                    <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                    <listhead>
                        <listheader width="20%" align="left">
                            <textbox value="@bind(vm.buscarCodigoProd)"
                                     class="form-control form-control-sm"
                                     tooltiptext="Código"
                                     placeholder="Código"
                                     onOK="@command('buscarLikeKardexCodigoProdComp')"
                                     onChange="self.setValue(self.getValue().toUpperCase());"/>
                        </listheader>
                        <listheader width="50%" align="left">
                            <textbox value="@bind(vm.buscarNombreProd)"
                                     id="idBusquedaProd"
                                     class="form-control form-control-sm"
                                     tooltiptext="Descripcion"
                                     placeholder="Descripcion"
                                     onOK="@command('buscarLikeKardexNombreProdComp')"
                                     onChange="self.setValue(self.getValue().toUpperCase());"/>
                        </listheader>
                        <listheader width="10%" label="% IVA" align="center"/>
                        <listheader width="12%" label="P COMPRA" align="center"/>
                        <listheader width="8%" label="" align="center"/>
                    </listhead>
                    <template name="model">
                        <listitem onOK="@command('agregarItemLista',valor=each.idProducto)">
                            <listcell zclass="mycss-listcell"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <textbox value="@bind(each.idProducto.prodCodigo)" onCreate="self.focus()"
                                         class="form-control form-control-sm"
                                         readonly="true"
                                         onDoubleClick="@command('agregarItemLista',valor=each.idProducto)"/>
                            </listcell>
                            <listcell zclass="mycss-listcell"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <textbox value="@bind(each.idProducto.prodNombre)"
                                         readonly="true"
                                         class="form-control form-control-sm"
                                         onDoubleClick="@command('agregarItemLista',valor=each.idProducto)"/>
                            </listcell>
                            <listcell zclass="mycss-listcell"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <decimalbox format="###" onOK="@command('agregarItemLista',valor=each.idProducto)"
                                            class="form-control form-control-sm"
                                            readonly="true"
                                            value="@bind(each.idProducto.prodIva)"
                                            width="96%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell" onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <label onOK="@command('agregarItemLista',valor=each.idProducto)"
                                       class="form-control form-control-sm"
                                       value="@bind(each.idProducto.pordCostoCompra)"
                                       width="96%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <div class="fa-solid fa-chevron-right"
                                     style="font-size:16px; padding:0.5em; cursor:pointer;font-weight: bold;color:#2b6b9e"
                                     onClick="@command('agregarItemLista',valor=each.idProducto)"
                                     tooltiptext="Asignar producto"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>

            <div sclass="kd-col kd-card">
                <label sclass="kd-card-title" value="Detalle de la compra"/>
                <listbox model="@load(vm.listaCompraProductosMOdel)"
                         mold="paging"
                         height="460px" pageSize="14"
                         nonselectableTags="*" checkmark="true"
                         multiple="true"
                         onSelect="@command('seleccionarRegistros')" width="99%">
                    <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                    <listhead>
                        <listheader width="6%" label="" align="left">
                            <button label="" src="/iconos/delete.png"
                                    onClick="@command('eliminarRegistros')"
                                    class="btn btn-secondary btn-sm"
                                    tooltiptext="Eliminar registros seleccionados"/>
                        </listheader>
                        <listheader width="10%" label="CODIGO" align="left"/>
                        <listheader width="10%" label="CANT" align="left"/>
                        <listheader width="10%" label="FACTOR" align="left"/>
                        <listheader width="10%" label="TRANSF" align="left"/>
                        <listheader width="40%" label="DESCRIPCIÓN" align="left"/>
                        <listheader width="10%" label="V.UNIT" align="left"/>
                        <listheader width="10%" label="V. TOTAL" align="left"/>
                    </listhead>
                    <template name="model">
                        <listitem>
                            <listcell/>
                            <listcell zclass="mycss-listcell">
                                <textbox class="form-control form-control-sm"
                                         onCreate="self.focus()"
                                         value="@bind(each.codigo)" width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox constraint="/^[0-9]{1,9}(?:[.][0-9]{1,3})?$/:Ingrese solo numeros"
                                         onOK="@command('calcularValores',valor=each)"
                                         class="form-control form-control-sm"
                                         onChange="@command('calcularValores',valor=each)"
                                         value="@bind(each.cantidad)" width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox value="@bind(each.factor)"
                                         onOK="@command('calcularValores',valor=each)"
                                         class="form-control form-control-sm"
                                         width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox value="@bind(each.totalTRanformado)"
                                         onOK="@command('calcularValores',valor=each)"
                                         class="form-control form-control-sm"
                                         width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox value="@bind(each.producto.prodNombre)"
                                         class="form-control form-control-sm"
                                         width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox constraint="/^[0-9]{1,9}(?:[.][0-9]{1,5})?$/:Ingrese solo numeros"
                                         onOK="@command('calcularValores',valor=each)"
                                         onChange="@command('calcularValores',valor=each)"
                                         class="form-control form-control-sm"
                                         value="@bind(each.subtotal)" width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <decimalbox readonly="true" format="###.#####"
                                            class="form-control form-control-sm"
                                            value="@bind(each.total)" width="99%"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </div>
    </div>
</zk>
