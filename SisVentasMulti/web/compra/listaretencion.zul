<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>  
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v6"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>

<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>

<zk  contentStyle="overflow:auto" width="100%" >
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
          viewModel="@id('vm') @init('com.ec.controlador.ListaRetenciones')"
          width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Lista de retenciones"/>
        <label sclass="kd-sub" value="Consulte por fecha, autorice y descargue el Excel."/>
        <div sclass="kd-card">
        <tabbox id="tboxPrincipal"  width="100%" sclass="lf-tabbox">
            <tabs >
                <tab label="Lista de retenciones" sclass="menutabs" />
            </tabs>
            <tabpanels >
                <tabpanel  width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field">
                                <span>Inicio</span>
                                <datebox
                                    value="@bind(vm.inicio)"
                                    readonly="true"
                                    onCreate="self.value = new Date()"
                                    buttonVisible="true"
                                    class="lf_date"
                                    lenient="true"
                                    format="dd/MM/yyyy"
                                    constraint="no empty: Ingrese de inicio de la busqueda"/>
                            </div>
                            <div class="wrapper_input lf_field">
                                <span>Fin</span>
                                <datebox
                                    value="@bind(vm.fin)"
                                    readonly="true"
                                    onCreate="self.value = new Date()"
                                    buttonVisible="true"
                                    class="lf_date"
                                    lenient="true"
                                    format="dd/MM/yyyy"
                                    constraint="no empty: IBuscar por fecha fin de la busqueda"/>
                            </div>
                            <button
                                class="fa-solid fa-magnifying-glass btn_fact lf_btn lf_btn_primary"
                                onClick="@command('buscarForFechas')"
                                tooltiptext="Buscar"
                                label="Por fecha"/>
                            <button
                                class="fa-solid fa-file-excel btn_fact lf_btn lf_btn_success"
                                onClick="@command('exportListboxToExcel')"
                                tooltiptext="Descargar"
                                label="Excel"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <listbox model="@load(vm.listaRetencionCompras)"
                             nonselectableTags=""  mold="paging" pageSize="12"  >
                        <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                        <listhead> 
                            <listheader width="15%"   >
                                <textbox value="@bind(vm.buscarNumFac)"  
                                         tooltiptext="Factura compra"
                                         class="form-control form-control-sm"                                         
                                         placeholder="Nº Factura"
                                         onOK="@command('buscarForNumeroFactura')"
                                         onChange="self.setValue(self.getValue().toUpperCase());" />
                            </listheader> 
                            <listheader width="10%"  label="Fecha emisiona" />    
                            <listheader width="20%"   >
                                <textbox value="@bind(vm.buscarSecuencial)"  
                                         tooltiptext="Secuencial de la retencion"
                                         class="form-control form-control-sm"                                         
                                         placeholder="Secuencial"
                                         onOK="@command('buscarForRetencion')"
                                         onChange="self.setValue(self.getValue().toUpperCase());" />
                            </listheader>        
                            <listheader width="20%"  label="Estado SRI" />  
                            <listheader width="12%"  label="Fecha Autorizacion" />       
                            <listheader width="43%"  label="Autorizacion" />                             
                            <listheader width="3%"  label="" />             
                            <listheader width="3%"  label="" />             
                            <listheader width="3%"  label="" />             
                            <listheader width="3%"  label="" />             
                            <listheader width="3%"  label="" />             
                            <listheader width="3%"  label="" />             
                        </listhead>  
                        
                    
                        <template name="model">                                                            
                            <listitem>
                                <listcell zclass = "mycss-listcell">
                                    <textbox readonly="true" style="font-size:12px ;background:#EBF5FB"                                           class="form-control form-control-sm"
                                             value="@bind(each.idCabecera.cabNumFactura)"  />
                                </listcell>
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    <datebox style="font-size:12px"
                                             class="form-control form-control-sm"
                                             value="@bind(each.rcoFecha)" 
                                             buttonVisible="false" 
                                             lenient="true" 
                                             format="medium"   />
                                </listcell>
                                
                               
                            
                                <listcell zclass = "mycss-listcell">
                                    <textbox readonly="true" style="font-size:12px ;background:#EBF5FB"
                                             class="form-control form-control-sm"
                                             value="@bind(each.rcoSecuencialText)"  />
                                </listcell>
                                
                                
                                <zk  choose="@bind(each.drcEstadosri)" >
                                    <zk  when="${each.drcEstadosri == 'AUTORIZADO'}"  >
                                        <listcell    zclass = "mycss-listcell"   style="font-size:12px; background:#C7FEC1" >
                                            <textbox readonly="true" style="font-size:12px ;background:#C7FEC1"
                                                        class="form-control form-control-sm"
                                                        value="@bind(each.drcEstadosri)" 
                                                        tooltiptext="@bind(each.rcoMsmInfoSri)"/>
                                        </listcell>
                                    </zk>
                                    <zk  when="${each.drcEstadosri == 'ANULADA'}"  >
                                        <listcell    zclass = "mycss-listcell"  style="background:#E2C1F5" >
                                           <textbox readonly="true" style="font-size:12px;background:#E2C1F5 "
                                           class="form-control form-control-sm"
                                           value="@bind(each.drcEstadosri)" 
                                           tooltiptext="@bind(each.rcoMsmInfoSri)"/>
                                        </listcell>
                                    </zk>
                                    <zk  >
                                        <listcell    zclass = "mycss-listcell"  style="background:#FCFE74" >
                                          <textbox readonly="true" style="font-size:12px ;background:#FCFE74"
                                           class="form-control form-control-sm"
                                           value="@bind(each.drcEstadosri)" 
                                           tooltiptext="@bind(each.rcoMsmInfoSri)"/>
                                        </listcell>
                                    </zk>
                                </zk>
                                
                                 
                                
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    <datebox style="font-size:12px"
                                             class="form-control form-control-sm"
                                             compact="true" value="@bind(each.rcoFechaAutorizacion)" 
                                             buttonVisible="false" lenient="true" 
                                             tooltiptext="@bind(each.drcMensajesri)"
                                             readonly="true"
                                             format="medium"  />
                                </listcell>
                                <listcell zclass = "mycss-listcell">
                                    <textbox readonly="true" style="font-size:12px ;background:#EBF5FB"
                                             class="form-control form-control-sm"
                                             value="@bind(each.rcoAutorizacion)"  />
                                </listcell>
                                  
                                <listcell   zclass = "mycss-listcell" >   
                                        
                                    <image src="/iconos/armareval.png"   
                                           onClick="@command('cambiarEstado',valor=each)"                                    
                                           class="btn-secondary btn-sm"                                               
                                           tooltiptext="Cambiar estado de la retencion"/> 
                                </listcell>
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    <image  if="${each.drcEstadosri!='AUTORIZADO'}" 
                                            src="/iconos/editar.png" 
                                            class=" grow"
                                            onClick="@command('crearRetencionCompra',valor=each)" 
                                            tooltiptext="editar retencion"/>
                                    
                                    <image if="${each.drcEstadosri=='S'}" 
                                           src="/iconos/listo_uno.png"   
                                           class=" grow"                                          
                                           tooltiptext="No se puede autorizar por que se encuentra en estado autorizado"/> 
                                </listcell>
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    <image if="${each.drcEstadosri!='AUTORIZADO'}"
                                           src="/iconos/sri24x24.png" 
                                           class="grow"
                                           onClick="@command('autorizarSRI',valor=each)" 
                                           tooltiptext="Autorizar facturas"/>
                                    
                                    <image if="${each.drcEstadosri=='AUTORIZADO'}" 
                                           src="/iconos/listo_uno.png"   
                                           class="grow"                                               
                                           tooltiptext="No se puede autorizar por que se encuentra en estado autorizado"/> 
                                </listcell>
                               
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9"> 
                                    <image if="${each.drcEstadosri!='AUTORIZADO'}"
                                           src="/iconos/reenviar.png" 
                                           class="grow"
                                           onClick="@command('reenviarSri',valor=each)" 
                                           tooltiptext="Reenviar retencion"/>
                                    
                                    <image if="${each.drcEstadosri=='AUTORIZADO'}" 
                                           src="/iconos/listo_uno.png"   
                                           class="grow"                                               
                                           tooltiptext="No se puede reenviar por que se encuentra en estado autorizado"/> 
                                </listcell>
                                
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    
                                    
                                    <image src="/iconos/factelect.jpg"   
                                           class="grow"  
                                           onClick="@command('reporteGeneral',valor=each)"                                              
                                           tooltiptext="Imprimir retencion"/> 
                                </listcell>
                                <listcell zclass = "mycss-listcell" style="font-size:12px;background:#F8F9F9">
                                    
                                    
                                    <image if="${each.drcEstadosri!='AUTORIZADO'}"
                                           src="/iconos/delete.png" 
                                           class="grow"  
                                           onClick="@command('eliminarRetencion',valor=each)"                                              
                                           tooltiptext="Eliminar retencion"/> 
                                    <image if="${each.drcEstadosri=='AUTORIZADO'}" 
                                           src="/iconos/listo_uno.png"   
                                           class="grow"                                               
                                           tooltiptext="No se puede eliminar por que se encuentra en estado autorizado"/> 
                                </listcell>
                                
                                
                                
                            </listitem>
                        </template>
                    </listbox>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
