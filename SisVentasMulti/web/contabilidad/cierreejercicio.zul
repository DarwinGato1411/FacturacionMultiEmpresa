<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v7"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css?v7"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v8"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.vistas.CierreEjercicioVm')"
         width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Cierre de ejercicio"/>
        <label sclass="kd-sub" value="Cierra ingresos (4), costos (5) y gastos (6) contra resultados acumulados y bloquea el año. Ejecute antes el SQL setup/fase5_cierre_reportes.sql. Parametrice RESULTADOS y PERDIDAS_ACUM."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox">
            <tabs>
                <tab label="Cierre de ejercicio" sclass="menutabs"/>
            </tabs>
            <tabpanels>
                <tabpanel width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field">
                                <span>Año</span>
                                <intbox value="@bind(vm.anio)" class="lf_date" width="90px"/>
                            </div>
                            <button class="fa-solid fa-magnifying-glass btn_fact lf_btn lf_btn_primary"
                                    onClick="@command('buscar')" label="Consultar"/>
                            <button class="btn_fact lf_btn lf_btn_primary"
                                    visible="@load(not vm.cerrado)"
                                    onClick="@command('cerrar')" label="Cerrar ejercicio"/>
                            <button class="btn_fact lf_btn lf_btn_warn"
                                    visible="@load(vm.cerrado)"
                                    onClick="@command('reabrir')" label="Reabrir año"/>
                            <label value="@load(vm.estado)"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <label sclass="ef-msg" value="@load(vm.mensaje)"/>
                    <listbox model="@load(vm.preview)" mold="paging" pageSize="20">
                        <listhead>
                            <listheader width="16%" label="Código"/>
                            <listheader width="48%" label="Cuenta de resultado (se cierra)"/>
                            <listheader width="20%" label="Saldo a cerrar"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell zclass="mycss-listcell"><label value="@bind(each.codigo)"/></listcell>
                                <listcell zclass="mycss-listcell"><label value="@bind(each.nombre)"/></listcell>
                                <listcell zclass="mycss-listcell"><label value="@bind(each.saldoFinal)"/></listcell>
                            </listitem>
                        </template>
                    </listbox>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
