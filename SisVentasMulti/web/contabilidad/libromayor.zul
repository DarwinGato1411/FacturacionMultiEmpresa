<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css?v7"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v8"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.vistas.LibroMayorVm')"
         width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Libro mayor"/>
        <label sclass="kd-sub" value="Movimientos y saldo de cada subcuenta. Excel incluye una hoja de mayor auxiliar (por cuenta; la glosa identifica el documento). PDF/imprimir abre un archivo para guardar como PDF."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox">
            <tabs>
                <tab label="Libro mayor" sclass="menutabs"/>
            </tabs>
            <tabpanels>
                <tabpanel width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field">
                                <span>Inicio</span>
                                <datebox value="@bind(vm.inicio)" compact="true" readonly="true"
                                         buttonVisible="true" class="lf_date" lenient="true"
                                         format="dd/MM/yyyy"/>
                            </div>
                            <div class="wrapper_input lf_field">
                                <span>Fin</span>
                                <datebox value="@bind(vm.fin)" compact="true" readonly="true"
                                         buttonVisible="true" class="lf_date" lenient="true"
                                         format="dd/MM/yyyy"/>
                            </div>
                            <div class="wrapper_input lf_field">
                                <span>Cuenta</span>
                                <textbox value="@bind(vm.filtroCuenta)" class="lf_date"
                                         placeholder="Código (ej. 1.01)"/>
                            </div>
                            <button class="fa-solid fa-magnifying-glass btn_fact lf_btn lf_btn_primary"
                                    onClick="@command('buscar')" label="Buscar"/>
                            <button class="btn_fact lf_btn lf_btn_secondary"
                                    onClick="@command('exportarExcel')" label="Excel (mayor + auxiliar)"/>
                            <button class="btn_fact lf_btn lf_btn_secondary"
                                    onClick="@command('exportarPdf')" label="PDF / imprimir"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <listbox model="@load(vm.lista)" mold="paging" pageSize="15">
                        <listhead>
                            <listheader width="16%" label="Código"/>
                            <listheader width="36%" label="Cuenta"/>
                            <listheader width="12%" label="Saldo ant."/>
                            <listheader width="12%" label="Debe"/>
                            <listheader width="12%" label="Haber"/>
                            <listheader width="12%" label="Saldo"/>
                        </listhead>
                        <template name="model">
                            <listitem onClick="@command('seleccionar', valor=each)">
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.codigo)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.nombre)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.saldoInicial)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.debe)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.haber)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.saldoFinal)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    <label sclass="kd-card-title" value="@load(vm.cuentaDetalle)"/>
                    <listbox model="@load(vm.detalle)" mold="paging" pageSize="12">
                        <listhead>
                            <listheader width="12%" label="Fecha"/>
                            <listheader width="8%" label="Asiento"/>
                            <listheader width="10%" label="Origen"/>
                            <listheader width="34%" label="Glosa"/>
                            <listheader width="12%" label="Debe"/>
                            <listheader width="12%" label="Haber"/>
                            <listheader width="12%" label="Saldo"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell zclass="mycss-listcell">
                                    <datebox compact="true" value="@bind(each.fecha)"
                                             height="30px" buttonVisible="false" lenient="true"
                                             readonly="true" format="medium" width="100%"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.numero)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.origen)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.glosa)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.debe)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.haber)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.saldo)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
