<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v6"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.vistas.AsientoManualVm')"
         width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Asiento manual"/>
        <label sclass="kd-sub" value="Asiento de la empresa de la sesión. Use códigos del plan NIIF de esta empresa. El debe debe igualar al haber."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox">
            <tabs>
                <tab label="Asiento manual" sclass="menutabs"/>
            </tabs>
            <tabpanels>
                <tabpanel width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field">
                                <span>Fecha</span>
                                <datebox value="@bind(vm.fecha)" compact="true" buttonVisible="true"
                                         class="lf_date" format="dd/MM/yyyy"/>
                            </div>
                            <div class="wrapper_input lf_field" width="320px">
                                <span>Glosa</span>
                                <textbox value="@bind(vm.glosa)" width="300px"/>
                            </div>
                            <button class="btn_fact lf_btn lf_btn_secondary"
                                    onClick="@command('agregarLinea')" label="Agregar línea"/>
                            <button class="btn_fact lf_btn lf_btn_secondary"
                                    onClick="@command('recalcular')" label="Sumar"/>
                            <button class="fa-solid fa-floppy-disk btn_fact lf_btn lf_btn_primary"
                                    onClick="@command('guardar')" label="Guardar asiento"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <listbox model="@load(vm.lineas)">
                        <listhead>
                            <listheader width="22%" label="Código subcuenta"/>
                            <listheader width="38%" label="Nombre"/>
                            <listheader width="20%" label="Debe"/>
                            <listheader width="20%" label="Haber"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell zclass="mycss-listcell">
                                    <textbox value="@bind(each.codigo)" width="95%"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.nombre)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <decimalbox value="@bind(each.debe)" format="#,##0.00" width="95%"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <decimalbox value="@bind(each.haber)" format="#,##0.00" width="95%"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    <label sclass="kd-card-title" value="@load(vm.resumenTotales)"/>
                    <label sclass="kd-sub" value="Pulse Sumar para actualizar. El debe debe coincidir con el haber."/>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
