<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/modales.css?v7"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v8"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.vistas.ParametrizarCuentasVm')"
         width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Parametrizar cuentas"/>
        <label sclass="kd-sub" value="El enlace es por empresa (tipoambiente). Las subcuentas deben existir en el plan NIIF de esta misma empresa."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox">
            <tabs>
                <tab label="Parametrizar cuentas" sclass="menutabs"/>
            </tabs>
            <tabpanels>
                <tabpanel width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <button class="fa-solid fa-floppy-disk btn_fact lf_btn lf_btn_primary"
                                    onClick="@command('guardar')"
                                    label="Guardar enlace"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <listbox model="@load(vm.lista)" mold="paging" pageSize="20">
                        <listhead>
                            <listheader width="18%" label="Evento"/>
                            <listheader width="42%" label="Uso"/>
                            <listheader width="40%" label="Código de subcuenta NIIF"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.parCodigo)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.parNombre)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <textbox class="form-control form-control-sm"
                                             value="@bind(each.codigoCuenta)"
                                             placeholder="Ej. 1.01.02.001"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
