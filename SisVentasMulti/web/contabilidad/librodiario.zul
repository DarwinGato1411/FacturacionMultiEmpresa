<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/ventas/facturar.css?v50"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v6"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.vistas.LibroDiarioVm')"
         width="100%" sclass="kd-page lista_facturas_page">
        <label sclass="kd-title" value="Libro diario"/>
        <label sclass="kd-sub" value="Solo asientos de la empresa de la sesión (tipoambiente). Se generan al guardar facturas (FACT) y compras de esa empresa."/>
        <div sclass="kd-card">
        <tabbox width="100%" sclass="lf-tabbox">
            <tabs>
                <tab label="Libro diario" sclass="menutabs"/>
            </tabs>
            <tabpanels>
                <tabpanel width="99%" class="factura lista_facturas">
                    <div class="factura_header lista_facturas_toolbar">
                        <div class="lf_panel lf_toolbar_line">
                            <div class="wrapper_input lf_field">
                                <span>Inicio</span>
                                <datebox value="@bind(vm.inicio)" compact="true" readonly="true"
                                         buttonVisible="true" class="lf_date" lenient="true"
                                         format="dd/MM/yyyy"/>
                            </div>
                            <div class="wrapper_input lf_field">
                                <span>Fin</span>
                                <datebox value="@bind(vm.fin)" compact="true" readonly="true"
                                         buttonVisible="true" class="lf_date" lenient="true"
                                         format="dd/MM/yyyy"/>
                            </div>
                            <button class="fa-solid fa-magnifying-glass btn_fact lf_btn lf_btn_primary"
                                    onClick="@command('buscar')" label="Buscar"/>
                        </div>
                    </div>
                    <div class="factura_body factura_body_content">
                    <listbox model="@load(vm.lista)" mold="paging" pageSize="15">
                        <listhead>
                            <listheader width="10%" label="N°"/>
                            <listheader width="14%" label="Fecha"/>
                            <listheader width="12%" label="Origen"/>
                            <listheader width="64%" label="Glosa"/>
                        </listhead>
                        <template name="model">
                            <listitem onClick="@command('seleccionar', valor=each)">
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.asiNumero)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <datebox compact="true" value="@bind(each.asiFecha)"
                                             height="30px" buttonVisible="false" lenient="true"
                                             readonly="true" format="medium" width="100%"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.asiOrigen)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.asiGlosa)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    <listbox model="@load(vm.detalle)" mold="paging" pageSize="12">
                        <listhead>
                            <listheader width="22%" label="Código"/>
                            <listheader width="38%" label="Cuenta"/>
                            <listheader width="20%" label="Debe"/>
                            <listheader width="20%" label="Haber"/>
                        </listhead>
                        <template name="model">
                            <listitem>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.idSubCuenta.subcNumero)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.idSubCuenta.subcNombre)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.detDebe)"/>
                                </listcell>
                                <listcell zclass="mycss-listcell">
                                    <label value="@bind(each.detHaber)"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                    </div>
                </tabpanel>
            </tabpanels>
        </tabbox>
        </div>
    </div>
</zk>
