        div.z-menubar-hor .z-menuitem-body-seld .z-menuitem-inner-r,
        div.z-menubar-hor .z-menuitem-body-seld .z-menuitem-inner-m .z-menuitem-btn,
        div.z-menubar-hor .z-menu-body-seld .z-menu-inner-l,
        div.z-menubar-hor .z-menu-body-seld .z-menu-inner-m,
