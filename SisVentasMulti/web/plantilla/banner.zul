            background-image: none !important;
            border: 0 none !important;
        }
    </style>
    <script><![CDATA[
        zk.afterMount(function () {
            function bindMenus() {
                var bar = document.querySelector(".banner .z-menubar");
                if (!bar) return;
                function inPopup(el) {
                    while (el) {
                        if (el.className && String(el.className).indexOf("z-menupopup") >= 0) return true;
                        el = el.parentNode;
                    }
                    return false;
                }
                function paint(menu, on) {
                    var bg = "transparent";
                    var fg = "#ffffff";
                    var nodes = menu.getElementsByTagName("*");
                    var apply = function (n) {
                        if (!n || !n.style || inPopup(n)) return;
                        var cls = n.className ? String(n.className) : "";
                        n.style.setProperty("background", bg, "important");
                        n.style.setProperty("background-color", bg, "important");
                        n.style.setProperty("background-image", "none", "important");
                        n.style.setProperty("color", fg, "important");
                        n.style.setProperty("border", "0px", "important");
                        n.style.setProperty("box-shadow", "none", "important");
                        if (cls.indexOf("inner-l") >= 0 || cls.indexOf("inner-r") >= 0) {
                            n.style.setProperty("background", bg, "important");
                            n.style.setProperty("background-image", "none", "important");
                        }
                    };
                    apply(menu);
                    for (var i = 0; i < nodes.length; i++) apply(nodes[i]);
                }
                var menus = bar.getElementsByClassName("z-menu");
                for (var i = 0; i < menus.length; i++) {
                    var menu = menus[i];
                    if (inPopup(menu)) continue;
                    if (menu.getAttribute("data-deck-bind") === "1") continue;
                    menu.setAttribute("data-deck-bind", "1");
                    paint(menu, false);
                    menu.addEventListener("mouseenter", function (m) { return function () { paint(m, false); }; }(menu));
                    menu.addEventListener("mouseleave", function (m) { return function () { paint(m, false); }; }(menu));
                    menu.addEventListener("click", function (m) { return function () { paint(m, false); }; }(menu));
                }
                var items = bar.querySelectorAll(".z-menubar-cnt > .z-menuitem");
                if (!items.length) {
                    items = [];
                    var allItems = bar.getElementsByClassName("z-menuitem");
                    for (var j = 0; j < allItems.length; j++) {
                        if (!inPopup(allItems[j])) items.push(allItems[j]);
                    }
                }
                for (var k = 0; k < items.length; k++) {
                    var item = items[k];
                    if (inPopup(item)) continue;
                    if (item.getAttribute("data-deck-bind") === "1") continue;
                    item.setAttribute("data-deck-bind", "1");
                    paint(item, false);
                    item.addEventListener("mouseenter", function (m) { return function () { paint(m, false); }; }(item));
                    item.addEventListener("mouseleave", function (m) { return function () { paint(m, false); }; }(item));
                }
                var scrolls = bar.querySelectorAll(".z-menubar-left, .z-menubar-right, .z-menubar-scroll");
                for (var s = 0; s < scrolls.length; s++) {
                    scrolls[s].style.setProperty("background", "transparent", "important");
                    scrolls[s].style.setProperty("background-image", "none", "important");
                }
            }
            bindMenus();
            setTimeout(bindMenus, 400);
            setTimeout(bindMenus, 1200);
            if (!window.__defactBannerLock) {
                window.__defactBannerLock = true;
                var obsBar = document.querySelector(".banner .z-menubar");
                if (obsBar && window.MutationObserver) {
                    new MutationObserver(function () { bindMenus(); }).observe(obsBar, {
                        attributes: true,
                        subtree: true,
                        attributeFilter: ["class"]
                    });
                }
            }
        });
    ]]></script>

    <div class="banner" id="loginWin"  style="height:auto;background:#122536;color:#ffffff"  width="100%"
         apply="com.ec.controlador.LogoutController" >
        <div class="banner-inner">
            <div class="banner-brand">
                <label value="DEFACT" sclass="banner-head" />
            </div>

            <div class="banner-nav">
                <div viewModel="@id('vm')" id="gridMenu"
                     apply="com.ec.controlador.MenuOpciones"
                     class="banner-menubar">
                    <menubar id="menubar" orient="horizontal" autodrop="true" scrollable="false">
                        <menu label="Ventas" id="menuEmitirfact">
                            <menupopup>
                                <menuitem label="Emitir Facturas" id="btnFacturar" />
                                <!--<menuitem label="Emitir Factura Parqueadero" id="btnFacturarPar" visible="false" />-->
                                           
                                <menuitem label="Facturas emitidas" id="btnNotaVentas" />
                                <menuitem label="Proformas emitidas" id="btnProformasEmitidas" />
                                <menuitem label="Facturas por cobrar" id="btnfactCobra" />          
                                <menuitem label="Notas credito" id="btnNotaCredito" />
                                <menuitem label="Emitir Guias de remision" id="btnEmitirGuiaRemision" />
                                <menuitem label="Guias de remision emitidas" id="btnGuiaRemision" />
                                <menuitem label="Cierre de caja" id="btnCierreCajaUsu" />
                            </menupopup>
                        </menu>
                        <menu label="Gestion de compras" id="menuCompras">
                            <menupopup>
                                <menuitem label="Ingreso de mercaderia" id="btnIngresoCompras" />
                                <menuitem label="Lista de facturas de compra" id="btnListaCompras" />
                                <menuitem label="Lista de retenciones" id="btnRetenciones" />
                            </menupopup>
                        </menu>
<!--                        <menu label="Gestion de guias" id="menuGuias">
                            <menupopup>
                               
                            </menupopup>
                        </menu>-->
                        <menu label="Kardex" id="menuKardex">
                            <menupopup>
                                <menuitem label="Ajuste de Entrada/Salida" id="btnAjuste" />
                                <menuitem label="Kardex detallado" id="btnKardex" />
                                <menuitem label="Kardex general" id="btnKardexPorProd" />
                            </menupopup>
                        </menu>
                        <menu label="Reportes" id="menuReportes">
                            <menupopup>
                                <menuitem label="Compras vs Ventas" id="btnBalanceUtilidad" />
                                <menuitem label="Acumulado de ventas" id="btnAcumuladoventas" />
                                <menuitem label="Rotacion Productos" id="btnRotacionProducto" />
                                <menuitem label="Lista de cierre de caja" id="btnListarCierre" />
                            </menupopup>
                        </menu>
                        <menuitem label="Catalogos" id="btnAdministarVenta" />
                        <menuitem label="Historial declaraciones" id="btnHisDeclaraciones" visible="false" />
                        <menuitem label="Gestion de usuarios" id="muenGestionUsu" />
                        <menuitem label="Gestion de empresas" id="muenGestionEmpresas" />
                        <menuitem label="Gestion facturas" id="btnGestionFactura" />
                        <menuitem label="Codigos de retencion" id="btnCodigoretencion" />
                        <menuitem label="Orden" id="btnOrden" visible="false" />
                        <menuitem label="Lista orden" id="btnlistaOrden" visible="false" />
                        <menuitem label="Salir" id="logoutMenu" visible="false" />
                    </menubar>
                </div>
            </div>

            <div class="banner-utils">
                <div apply="org.zkoss.bind.BindComposer"
                     viewModel="@id('vm') @init('com.ec.controlador.MenuToolbar')">
                    <toolbar id="tb" height="50px" sclass="banner-toolbar" style="background-color:transparent;border:none;" >
                        <toolbarbutton label="Facturar" image="/iconos/fact.png" onClick="@command('facturar')" />
                        <toolbarbutton image="/iconos/user.png" label="Cliente" onClick="@command('nuevoCliente')" />
                        <toolbarbutton image="/iconos/page.png" label="Producto" onClick="@command('nuevoProducto')" />
                    </toolbar>
                </div>
                <label value="Usuario: " if="${not sessionScope.userCredential.anonymous}" sclass="banner-user" />
                <label value="${sessionScope.usuario.nombreUsuario}" sclass="banner-user" if="${not sessionScope.userCredential.anonymous}" />
                <a sclass="logout banner-logout" id="logout" >
                    <label  value="Salir" if="${not sessionScope.userCredential.anonymous}" sclass="banner-logout-text"/>
                    <image src="/iconos/logout-24.png"  />
                </a>
            </div>
        </div>
    </div>
</zk>
