        .banner .z-menubar .z-menu-selected > .z-menu-content,
        .banner .z-menubar .z-menuitem-seld,
        .banner .z-menubar .z-menuitem-seld td,
        .banner .z-menubar .z-menuitem-seld .z-menuitem-btn,
        .banner .z-menubar .z-menuitem-seld .z-menuitem-inner-l,
        .banner .z-menubar .z-menuitem-seld .z-menuitem-inner-m,
        .banner .z-menubar .z-menuitem-seld .z-menuitem-inner-r,
        .banner .z-menuitem-body-seld,
        .banner .z-menuitem-body-seld td,
        .banner .z-menuitem-body-seld .z-menuitem-inner-l,
