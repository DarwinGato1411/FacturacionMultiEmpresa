        .banner .z-menubar .z-menuitem-over .z-menuitem-inner-l,
        .banner .z-menubar .z-menuitem-over .z-menuitem-inner-m,
        .banner .z-menubar .z-menuitem-over .z-menuitem-inner-r,
        .banner .z-menuitem-body-over,
        .banner .z-menuitem-body-over td,
        .banner .z-menuitem-body-over .z-menuitem-inner-l,
        .banner .z-menuitem-body-over .z-menuitem-inner-m,
        .banner .z-menuitem-body-over .z-menuitem-inner-r,
        .banner .z-menuitem-body-over .z-menuitem-btn,
        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-l,
        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-m,
        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-r,
        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-m .z-menuitem-btn,
        div.z-menubar-hor .z-menu-body-over .z-menu-inner-l,
        div.z-menubar-hor .z-menu-body-over .z-menu-inner-m,
