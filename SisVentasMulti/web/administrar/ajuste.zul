<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/boostrap/bootstrap.css"?>
<?link rel="stylesheet" type="text/css" href="/css/style.css"?>
<?link rel="stylesheet" type="text/css" href="/css/app/kardex.css?v6"?>
<?link rel="stylesheet" type="text/css" href="/css/app/theme.css?v41"?>
<?link rel="stylesheet" type="text/css" href="/css/app/banner-lock.css?v4"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<?init class="org.zkoss.zk.ui.util.Composition" arg0="/plantilla/plantilla.zul"?>
<?link rel="icon" type="image/x-icon" href="/iconos/deckxel.ico"?>
<zk contentStyle="overflow:auto" width="100%">
    <style>
        .z-listbox-autopaging .z-listcell-cnt {
            height: 15px;
            overflow: hidden;
        }
    </style>

    <div self="@define(content)" apply="org.zkoss.bind.BindComposer"
         ctrlKeys="^P" onCtrlKey="@command('Guardar')"
         viewModel="@id('vm') @init('com.ec.controlador.AjusteEntradaSalida')"
         sclass="kd-page" width="100%">

        <timer id="timer" delay="300000" repeats="true" onTimer="@command('refrescarPagina')"/>

        <label sclass="kd-title" value="Ajuste de entrada / salida"/>
        <label sclass="kd-sub" value="Doble clic o la flecha para agregar el producto. Indique el motivo y el tipo de movimiento antes de guardar."/>

        <div sclass="kd-toolbar">
            <div sclass="kd-motivo">
                <label sclass="kd-kpi-label" value="Motivo del ajuste"/>
                <textbox class="form-control form-control-sm"
                         onChange="self.setValue(self.getValue().toUpperCase())"
                         ctrlKeys="^A" onCtrlKey="@command('buscarClienteEnLista')"
                         placeholder="Motivo del ajuste"
                         value="@bind(vm.motivoAjuste)"
                         maxlength="150"/>
            </div>
            <div sclass="kd-radio-wrap">
                <label sclass="kd-kpi-label" value="Tipo de ajuste"/>
                <radiogroup selectedItem="@bind(vm.tipoAjuste)">
                    <radio label="ENTRADA" value="ING"/>
                    <radio label="SALIDA" value="SAL"/>
                </radiogroup>
            </div>
            <div sclass="kd-toolbar-actions">
                <button class="fa-solid fa-floppy-disk btn_fact btn_primary"
                        autodisable="self"
                        onClick="@command('Guardar')"
                        tooltiptext="Guardar"
                        label="Guardar"/>
            </div>
        </div>

        <div sclass="kd-split">
            <div sclass="kd-col kd-card">
                <label sclass="kd-card-title" value="Productos en kardex"/>
                <listbox model="@load(vm.listaKardexProducto)"
                         nonselectableTags="" mold="paging" pageSize="12">
                    <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                    <listhead>
                        <listheader width="20%" align="left">
                            <textbox value="@bind(vm.buscarCodigoProd)"
                                     class="form-control form-control-sm"
                                     tooltiptext="Código"
                                     placeholder="Código"
                                     onOK="@command('buscarLikeKardexCodigoProd')"
                                     onChange="self.setValue(self.getValue().toUpperCase());"/>
                        </listheader>
                        <listheader width="55%" align="left">
                            <textbox value="@bind(vm.buscarNombreProd)"
                                     id="idBusquedaProd"
                                     class="form-control form-control-sm"
                                     tooltiptext="Descripcion"
                                     placeholder="Descripción"
                                     onOK="@command('buscarLikeKardexNombreProd')"
                                     onChange="self.setValue(self.getValue().toUpperCase());"/>
                        </listheader>
                        <listheader width="15%" label="Stock" align="center"/>
                        <listheader width="10%" label="" align="center"/>
                    </listhead>
                    <template name="model">
                        <listitem onOK="@command('agregarItemLista',valor=each.idProducto)">
                            <listcell zclass="mycss-listcell"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <textbox value="@bind(each.idProducto.prodCodigo)" onCreate="self.focus()"
                                         class="form-control form-control-sm"
                                         readonly="true"
                                         onDoubleClick="@command('agregarItemLista',valor=each.idProducto)"/>
                            </listcell>
                            <listcell zclass="mycss-listcell"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <textbox value="@bind(each.idProducto.prodNombre)"
                                         readonly="true"
                                         class="form-control form-control-sm"
                                         onDoubleClick="@command('agregarItemLista',valor=each.idProducto)"/>
                            </listcell>
                            <listcell zclass="mycss-listcell" sclass="kd-ok"
                                      if="${each.verificaStock}"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <label onOK="@command('agregarItemLista',valor=each.idProducto)"
                                       class="form-control form-control-sm"
                                       value="@bind(each.karTotal)"
                                       width="96%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell" sclass="kd-low"
                                      if="${!each.verificaStock}"
                                      onDoubleClick="@command('agregarItemLista',valor=each.idProducto)">
                                <label onOK="@command('agregarItemLista',valor=each.idProducto)"
                                       class="form-control form-control-sm"
                                       value="@bind(each.karTotal)"
                                       width="96%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <div class="fa-solid fa-chevron-right"
                                     style="font-size:16px; padding:0.5em; cursor:pointer;font-weight: bold"
                                     onClick="@command('agregarItemLista',valor=each.idProducto)"
                                     tooltiptext="Asignar producto"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>

            <div sclass="kd-col kd-card">
                <label sclass="kd-card-title" value="Detalle del ajuste"/>
                <listbox model="@load(vm.listaDetalleFacturaDAOMOdel)"
                         mold="paging"
                         height="400px" autopaging="true"
                         nonselectableTags="*" checkmark="true"
                         multiple="true"
                         onSelect="@command('seleccionarRegistros')">
                    <custom-attributes org.zkoss.zul.listbox.rod="true"/>
                    <listhead>
                        <listheader width="35px" label="" align="left">
                            <button label="" src="/iconos/delete.png"
                                    onClick="@command('eliminarRegistros')"
                                    class="btn btn-secondary btn-sm"
                                    tooltiptext="Eliminar registros seleccionados"/>
                        </listheader>
                        <listheader width="20%" label="Código" align="left"/>
                        <listheader width="12%" label="Cantidad" align="left"/>
                        <listheader width="68%" label="Descripción" align="left"/>
                    </listhead>
                    <template name="model">
                        <listitem>
                            <listcell/>
                            <listcell zclass="mycss-listcell">
                                <textbox onCreate="self.focus()"
                                         class="form-control form-control-sm"
                                         value="@bind(each.codigo)"
                                         onOK="@command('buscarPorCodigo',valor=each)"
                                         width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox constraint="/^[0-9]{1,9}(?:[.][0-9]{1,3})?$/:Ingrese solo numeros"
                                         class="form-control form-control-sm"
                                         value="@bind(each.cantidad)" width="99%"/>
                            </listcell>
                            <listcell zclass="mycss-listcell">
                                <textbox value="@bind(each.descripcion)"
                                         readonly="true"
                                         class="form-control form-control-sm"
                                         width="99%"/>
                            </listcell>
                        </listitem>
                    </template>
                </listbox>
            </div>
        </div>
    </div>
</zk>
