<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/app/sri.css?v29"?>
<?script src="https://kit.fontawesome.com/484b16c999.js"?>
<?script src="/js/icon.js"?>
<?init class="com.ec.seguridad.Autentificador"?>
<zk>
    <div apply="org.zkoss.bind.BindComposer"
         viewModel="@id('vm') @init('com.ec.controlador.Configuracion')"
         class="sri_page" width="100%">

        <hlayout class="sri_toolbar sri_toolbar_line" width="100%" valign="middle">
            <label class="sri_toolbar_title" value="Configuración SRI"/>
            <div class="sri_toolbar_rest">
                <button class="fa-solid fa-floppy-disk btn_fact btn_primary"
                        onClick="@command('guardar')"
                        tooltiptext="Guardar informacion"
                        label="Guardar"/>
            </div>
        </hlayout>

        <div class="sri_card">
            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Usuario SRI en línea"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amUsuariosri)"
                             placeholder="RUC o usuario del portal"
                             class="form-control form-control-sm"
                             tooltiptext="Usuario de SRI en línea"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Clave SRI en línea"/>
                    <textbox width="100%" type="password" value="@bind(vm.tipoambiente.amClaveSriLinea)"
                             placeholder="Clave del portal"
                             class="form-control form-control-sm"
                             tooltiptext="Clave de SRI en línea (no es la firma)"/>
                </div>
                <div class="sri_field"/>
                <div class="sri_field"/>
                <div class="sri_field">
                    <label class="sri_label" value="Ambiente"/>
                    <radiogroup class="sri_radios"
                                onCheck="@command('ambienteCodigo')"
                                selectedItem="@bind(vm.amCodifo)">
                        <radio label="PRUEBAS" value="1"/>
                        <radio label="PRODUCCION" value="2"/>
                    </radiogroup>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Contabilidad"/>
                    <radiogroup class="sri_radios"
                                selectedItem="@bind(vm.llevaContabilidad)">
                        <radio label="NO" value="NO"/>
                        <radio label="SI" value="SI"/>
                    </radiogroup>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Ruta base"/>
                    <combobox width="100%" model="@load(vm.listaDicos)" readonly="false"
                              class="textoFechaDateBox"
                              selectedItem="@bind(vm.tipoambiente.amUnidadDisco)"
                              tooltiptext="Ruta base dependiendo del sistema operativo (D: ó /Documentos)">
                        <template name="model">
                            <comboitem label="@bind(each)"/>
                        </template>
                    </combobox>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="RUC"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amRuc)"
                             placeholder="RUC..."
                             onOK="@command('buscarCatastro')"
                             class="form-control form-control-sm"
                             tooltiptext="RUC"/>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Razón social"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amRazonSocial)"
                             placeholder="Razon Social"
                             class="form-control form-control-sm"
                             tooltiptext="Razon Social"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Nombre comercial"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amNombreComercial)"
                             placeholder="Nombre Comercial"
                             class="form-control form-control-sm"
                             tooltiptext="Nombre Comercial"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Teléfono"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amTelefono)"
                             placeholder="062918661"
                             maxlength="10"
                             class="form-control form-control-sm"
                             tooltiptext="Contacto de la empresa"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Nro. contribuyente"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amNroContribuyente)"
                             placeholder="Numero contribuyente"
                             class="form-control form-control-sm"
                             tooltiptext="Número de contribuyente"/>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Firma digital"/>
                    <hlayout width="100%" valign="middle" class="sri_file" spacing="4px">
                        <textbox width="100%"
                                 value="@bind(vm.tipoambiente.amDirFirma)"
                                 onDoubleClick="@command('verInformacion')"
                                 placeholder="INGRESE SU FIRMA DIGITAL"
                                 class="form-control form-control-sm"
                                 tooltiptext="Nombre de la firma electrónica (fernando_perez.p12)"/>
                        <button sclass="sri_file_btn" label="..."
                                onClick="@command('subirFirma')"
                                tooltiptext="Subir archivos"/>
                    </hlayout>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Clave de la firma"/>
                    <textbox width="100%" type="password"
                             value="@bind(vm.tipoambiente.amClaveAccesoSri)"
                             placeholder="Clave de la firma electronica"
                             onChange="@command('validarFirma')"
                             class="form-control form-control-sm"
                             tooltiptext="Clave de la firma electronica"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Logotipo"/>
                    <hlayout width="100%" valign="middle" class="sri_file" spacing="4px">
                        <textbox width="100%"
                                 value="@bind(vm.tipoambiente.am_DirImgPuntoVenta)"
                                 placeholder="Logotipo de la empresa"
                                 class="form-control form-control-sm"
                                 tooltiptext="Logotipo de la empresa"/>
                        <button sclass="sri_file_btn" label="..."
                                onClick="@command('subirPathImagen')"
                                tooltiptext="Subir logotipo de la empresa"/>
                    </hlayout>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Establecimiento"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amEstab)"
                             placeholder="001"
                             maxlength="3"
                             class="form-control form-control-sm"
                             tooltiptext="Establecimiento asignado por el SRI (001)"/>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Punto de emisión"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amPtoemi)"
                             placeholder="001"
                             maxlength="3"
                             class="form-control form-control-sm"
                             tooltiptext="Punto de emision"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Dirección matriz"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amDireccionMatriz)"
                             placeholder="Direccion Matriz"
                             class="form-control form-control-sm"
                             tooltiptext="Direccion matriz"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Dirección establecimiento"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amDireccionSucursal)"
                             placeholder="Direccion establecimiento sucursal"
                             class="form-control form-control-sm"
                             tooltiptext="Direccion establecimiento"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Impresión"/>
                    <radiogroup class="sri_radios"
                                selectedItem="@bind(vm.tipoambiente.amComprobanteImprime)">
                        <radio label="Factura Electrónica" value="factura.jasper"/>
                        <radio label="Punto Venta" value="puntoventa.jasper"/>
                    </radiogroup>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Protocolo"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amProtocol)"
                             placeholder="smtp"
                             class="form-control form-control-sm"
                             tooltiptext="Protocolo: smtp"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Puerto"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amPort)"
                             placeholder="587"
                             class="form-control form-control-sm"
                             tooltiptext="Puerto: 587"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Host"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amHost)"
                             placeholder="smtp.gmail.com"
                             class="form-control form-control-sm"
                             tooltiptext="Host: smtp.gmail.com"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Usuario"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amUsuarioSmpt)"
                             placeholder="correo@gmail.com"
                             class="form-control form-control-sm"
                             tooltiptext="Usuario SMTP"/>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Password"/>
                    <textbox width="100%" type="password"
                             value="@bind(vm.tipoambiente.amPassword)"
                             placeholder="Password123"
                             class="form-control form-control-sm"
                             tooltiptext="Password SMTP"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Graba ICE"/>
                    <radiogroup class="sri_radios"
                                selectedItem="@bind(vm.grabaICE)">
                        <radio label="SI" value="S"/>
                        <radio label="NO" value="N"/>
                    </radiogroup>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Porcentaje ICE"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amValorIce)"
                             placeholder="15%"
                             class="form-control form-control-sm"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Código ICE"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amCodigoIce)"
                             placeholder="36589"
                             class="form-control form-control-sm"/>
                </div>
            </div>

            <div class="sri_grid">
                <div class="sri_field">
                    <label class="sri_label" value="Sec. factura"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amSecFactura)"
                             placeholder="123"
                             class="form-control form-control-sm"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Sec. retención"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amSecRetencion)"
                             placeholder="123"
                             class="form-control form-control-sm"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Sec. nota crédito"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amSecNotaCredito)"
                             placeholder="123"
                             class="form-control form-control-sm"/>
                </div>
                <div class="sri_field">
                    <label class="sri_label" value="Sec. guías"/>
                    <textbox width="100%" value="@bind(vm.tipoambiente.amSecGuia)"
                             placeholder="123"
                             class="form-control form-control-sm"/>
                </div>
            </div>

            <div class="sri_checks">
                <checkbox id="chkRM"
                          label="CONTRIBUYENTE REGIMEN GENERAL"
                          checked="@bind(vm.tipoambiente.amGeneral)"/>
                <checkbox id="chkRG"
                          label="CONTRIBUYENTE REGIMEN RIMPE"
                          checked="@bind(vm.tipoambiente.amRimpe)"/>
                <checkbox id="chkRGP"
                          label="CONTRIBUYENTE NEGOCIO POPULAR - RÉGIMEN RIMPE"
                          checked="@bind(vm.tipoambiente.amRimpePopular)"/>
                <checkbox id="chkAR"
                          label="AGENTE DE RETENCION"
                          checked="@bind(vm.tipoambiente.amAgeRet)"/>
                <checkbox id="chkCE"
                          label="CONTRIBUYENTE ESPECIAL"
                          checked="@bind(vm.tipoambiente.amContrEsp)"/>
                <checkbox id="chkEX"
                          label="EXPORTADORES"
                          checked="@bind(vm.tipoambiente.amExp)"/>
            </div>
        </div>
    </div>
</zk>
